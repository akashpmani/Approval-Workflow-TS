// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRoles {
  HR
  MANAGER
}

enum PurchaseStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum ExpenseClaimsStatus {
  REQUESTED
  APPROVED
  CLAIMED
  REJECTED
}

enum LeaveRequestStatus {
  REQUESTED
  APPROVED
  CANCELLED
  REJECTED
}

enum LeaveTypes {
  SICK_LEAVE
  CASUAL_LEAVE
  LOSS_OF_PAY
}

//user model
model User { 
  id      Int      @id @default(autoincrement()) 
  email   String   @unique
  name    String

} 



