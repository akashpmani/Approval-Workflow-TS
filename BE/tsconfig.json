{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "moduleResolution": "node",
    "resolveJsonModule": true,

    "baseUrl": ".",
    "paths": {
      "@prismaClient": ["prisma/generated/client"]
    }
  },
  "include": [
              "src/**/*.ts",
              "src/types/**/*"
          ],
  "exclude": ["node_modules", "dist"]
}