{
  "info": {
    "name": "Approval Workflow API",
    "description": "Postman collection for testing Approval Workflow API endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"johndoe\",\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"email\": \"john@example.com\",\n  \"phone\": \"9876543210\",\n  \"password\": \"Password123\",\n  \"role\": \"USER\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register",
                ""
              ]
            },
            "description": "Register a new user account"
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"john@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login",
                ""
              ]
            },
            "description": "Login with email or phone and password"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Test Endpoints",
      "item": [
        {
          "name": "Test Allowany",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"test\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/test/allowany/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "test",
                "allowany",
                ""
              ]
            },
            "description": "Test endpoint without authentication"
          },
          "response": []
        },
        {
          "name": "Test Authenticated",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "description": "JWT token from login response"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"authenticated test\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/test/authenticated/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "test",
                "authenticated",
                ""
              ]
            },
            "description": "Test endpoint with JWT authentication"
          },
          "response": []
        }
      ]
    },
    {
